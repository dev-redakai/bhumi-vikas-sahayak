# ---- LLM providers (tried in LLM_PROVIDER_ORDER; Cerebras is primary) ----
CEREBRAS_API_KEY=
CEREBRAS_MODELS=gpt-oss-120b,llama-3.3-70b,qwen-3-32b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini
LLM_PROVIDER_ORDER=cerebras,anthropic,openai_compat
LLM_TIMEOUT_S=25
PROVIDER_COOLDOWN_S=60

# ---- Gateway ----
# name:key:role  (roles: partner = ask/search/rules/calc; admin = everything)
GATEWAY_API_KEYS=demo:bvs-demo-key:partner,ops:change-me-admin:admin
GATEWAY_UI_KEY=bvs-web-ui
RATE_LIMIT_PER_MIN=60
# empty = run backend in-process (single container); set to http://backend:8000 for split deployment
BACKEND_URL=
